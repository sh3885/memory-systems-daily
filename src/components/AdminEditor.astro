---
import { ArrowLeft, Eye, Send, Trash2 } from "@lucide/astro";

interface Props {
  mode: "new" | "edit";
  slug?: string;
  heading: string;
  postUrl?: string;
}

const { mode, slug = "", heading, postUrl = "" } = Astro.props;
---

<header class="admin-head">
  <div class="admin-head-text">
    <a class="back-link" href="/admin/"><ArrowLeft size={15} />글 관리로 돌아가기</a>
    <h1>{heading}</h1>
  </div>
  {mode === "edit" && postUrl && (
    <div class="admin-head-actions">
      <a class="btn ghost" href={postUrl}><Eye size={16} />게시글 보기</a>
    </div>
  )}
</header>

<p class="status-line admin-status" data-admin-status role="status"></p>

<div class="editor-layout">
  <form class="admin-form editor-form" data-admin-form data-mode={mode} data-slug={slug}>
    <label>
      <span>제목</span>
      <input name="title" required placeholder="왜 KV Cache는 메모리를 많이 먹는가" />
    </label>

    <div class="form-row">
      <label>
        <span>Slug (URL)</span>
        <input name="slug" placeholder="kv-cache-memory" disabled={mode === "edit"} />
      </label>
      <label>
        <span>카테고리</span>
        <select name="category">
          <option value="LLM">LLM</option>
          <option value="Memory">Memory</option>
          <option value="System">System</option>
        </select>
      </label>
    </div>

    <label>
      <span>요약</span>
      <input name="description" placeholder="목록과 검색 결과에 표시할 한 줄 설명" />
    </label>

    <label>
      <span>태그 <em>쉼표로 구분</em></span>
      <input name="tags" placeholder="LLM, KV Cache, Bandwidth" />
    </label>

    <label class="editor-body">
      <span>본문 <em>Markdown</em></span>
      <textarea name="markdown" required rows="24" placeholder="# 제목&#10;&#10;본문을 Markdown으로 작성하세요."></textarea>
    </label>

    <div class="admin-form-actions">
      <button type="submit" data-admin-submit>
        <Send size={16} />{mode === "edit" ? "변경 사항 저장" : "발행하기"}
      </button>
      <a class="btn ghost" href="/admin/">취소</a>
      {mode === "edit" && (
        <button type="button" class="btn danger push-end" data-admin-delete>
          <Trash2 size={15} />글 삭제
        </button>
      )}
    </div>
  </form>

  <aside class="editor-side">
    <section class="admin-panel">
      <h2>미리보기</h2>
      <div class="admin-preview" data-admin-preview></div>
    </section>
    <section class="admin-panel">
      <h2>작성 안내</h2>
      <ul class="plain-list helper-list">
        <li>본문은 <code>#</code> 제목으로 시작합니다.</li>
        <li>YAML frontmatter는 저장할 때 자동으로 만들어집니다.</li>
        <li>저장하면 GitHub에 커밋되고, 공개 사이트는 다음 배포에 반영됩니다.</li>
      </ul>
    </section>
  </aside>
</div>
